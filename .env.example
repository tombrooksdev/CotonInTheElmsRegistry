# Copy to .env and fill in. Never commit .env.
WEB_PORT=8080
SITE_URL=http://localhost:8080

DB_NAME=coton_register
DB_USER=coton
DB_PASS=change_me
DB_ROOT_PASS=change_me_too

# Any long random string
IP_SALT=change_me
# Generate: docker compose run --rm web php -r "echo password_hash('yourpassword', PASSWORD_DEFAULT);"
# IMPORTANT: in .env, escape each $ in the hash as $$ or compose will mangle it
ADMIN_PASSWORD_HASH=

# Microsoft Graph app registration (client credentials flow, application permission Mail.Send, admin consent granted)
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_SENDER_EMAIL=noreply@bssweb.co.uk

# Subject line for the signup confirmation email
CONFIRM_EMAIL_SUBJECT=Please confirm your Coton in the Elms business listing
